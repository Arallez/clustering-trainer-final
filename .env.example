# =====================================================================
#  Шаблон файла переменных окружения.
#  Скопируйте этот файл в .env и подставьте свои значения:
#      cp .env.example .env
#  В .env.example НЕ должно быть реальных секретов — только заглушки.
# =====================================================================


# ---------------------------------------------------------------------
# 1. Django
# ---------------------------------------------------------------------
# Сгенерировать ключ можно командой:
#   python -c "from secrets import token_urlsafe; print(token_urlsafe(50))"
SECRET_KEY=replace-me-with-a-random-50-char-string

# В продакшене значение должно быть False.
DEBUG=True

# Через запятую, без пробелов.
ALLOWED_HOSTS=localhost,127.0.0.1


# ---------------------------------------------------------------------
# 2. База данных (PostgreSQL)
# ---------------------------------------------------------------------
# Локальная разработка (без Docker):
DB_NAME=clustering_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Запуск через docker-compose (значения подставляются автоматически):
#   DB_HOST=db
#   DB_USER=admin
#   DB_PASSWORD=secretpassword


# ---------------------------------------------------------------------
# 3. Электронная почта
# ---------------------------------------------------------------------
DEFAULT_FROM_EMAIL=Clustering Trainer <noreply@clustering-trainer.local>

# При подключении реального SMTP (необязательно):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password


# ---------------------------------------------------------------------
# 4. Песочница выполнения пользовательского кода
# ---------------------------------------------------------------------
# docker | inprocess
SANDBOX_EXECUTOR=docker
SANDBOX_IMAGE=clustering-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_INSTRUCTIONS=200000
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_COMPARISON_ATOL=0.01
SANDBOX_DISABLE_NETWORK=True
SANDBOX_ALLOW_INPROCESS_FALLBACK=True


# ---------------------------------------------------------------------
# 5. Внешние сервисы
# ---------------------------------------------------------------------
# Получите ключ в личном кабинете GigaChat: https://developers.sber.ru/
GIGACHAT_API_KEY=your_gigachat_api_key
